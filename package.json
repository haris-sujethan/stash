{
  "name": "stash",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26" },
  "workspaces": [
    "packages/context-format",
    "packages/core",
    "packages/agent-adapters",
    "packages/llm-adapters",
    "apps/cli",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w apps/web",
    "seed": "npm run seed -w apps/web --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
